{
  "name": "@aura-note/api",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "lint": "tsc --noEmit -p tsconfig.json",
    "lint:phi": "node ../../scripts/lint-phi.js apps/api",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test src/schedule/schedule.repository.test.ts src/schedule/schedule.service.test.ts src/ai/ai.service.test.ts src/integrations/ehr.service.test.ts src/integrations/clinicos.service.test.ts src/coaching/coaching.service.test.ts src/support/support.service.test.ts",
    "test:unit": "pnpm test",
    "test:e2e": "node --import tsx --test src/schedule/schedule.e2e.test.ts src/ai/ai.e2e.test.ts src/integrations/ehr.e2e.test.ts src/integrations/clinicos.e2e.test.ts src/coaching/coaching.e2e.test.ts src/support/support.e2e.test.ts",
    "test:prisma-schedule-adapter": "node --import tsx --test src/schedule/prisma-schedule.repository.integration.test.ts",
    "test:tenant-isolation": "node --import tsx --test src/schedule/prisma-schedule.tenant-isolation.integration.test.ts"
  },
  "dependencies": {
    "@aura-note/contracts": "workspace:^",
    "@aura-note/domain": "workspace:^",
    "@aura-note/ai-gateway": "workspace:^",
    "@aura-note/clinicos-adapter": "workspace:^",
    "@aura-note/ehr-adapters": "workspace:^",
    "@aura-note/persistence": "workspace:^",
    "@aura-note/security": "workspace:^",
    "@aura-note/testing": "workspace:^",
    "@prisma/client": "^6.0.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.0",
    "@types/supertest": "^6.0.0",
    "supertest": "^7.0.0",
    "typescript": "^5.6.0"
  }
}
