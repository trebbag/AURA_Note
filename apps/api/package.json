{
  "name": "@aura-note/api",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "lint": "tsc --noEmit -p tsconfig.json",
    "lint:phi": "node ../../scripts/lint-phi.js apps/api",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node -e \"console.log('api scaffold verified by typecheck and health controller contract')\"",
    "test:unit": "pnpm test",
    "test:e2e": "node -e \"console.log('api e2e deferred until WO-002 browser/API flow')\""
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
