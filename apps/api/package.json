{
  "name": "@aura-note/api",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "lint": "tsc --noEmit -p tsconfig.json",
    "lint:phi": "node ../../scripts/lint-phi.js apps/api",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test src/schedule/schedule.service.test.ts",
    "test:unit": "pnpm test",
    "test:e2e": "node --import tsx --test src/schedule/schedule.e2e.test.ts"
  },
  "dependencies": {
    "@aura-note/contracts": "workspace:^",
    "@aura-note/domain": "workspace:^",
    "@aura-note/security": "workspace:^",
    "@aura-note/testing": "workspace:^",
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.0",
    "@types/supertest": "^6.0.0",
    "supertest": "^7.0.0",
    "typescript": "^5.6.0"
  }
}
