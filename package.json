{
  "name": "aura-note-v1",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "test:unit": "turbo test:unit",
    "test:e2e": "turbo test:e2e",
    "test:browser": "playwright test",
    "lint": "turbo lint",
    "lint:phi": "turbo lint:phi",
    "typecheck": "turbo typecheck",
    "acceptance:readiness": "node scripts/acceptance-readiness.js",
    "db:schema:validate": "DATABASE_URL=postgresql://aura_note:aura_note@localhost:5432/aura_note_dev prisma validate --schema packages/contracts/prisma/schema.prisma",
    "db:client:generate": "DATABASE_URL=postgresql://aura_note:aura_note@localhost:5432/aura_note_dev prisma generate --schema packages/contracts/prisma/schema.prisma",
    "db:migration:diff": "DATABASE_URL=postgresql://aura_note:aura_note@localhost:5432/aura_note_dev prisma migrate diff --from-empty --to-schema-datamodel packages/contracts/prisma/schema.prisma --script",
    "persistence:foundation": "pnpm db:schema:validate && node scripts/validate-persistence-foundation.js",
    "persistence:runtime-readiness": "node scripts/validate-persistence-runtime-readiness.js",
    "persistence:adapter-readiness": "pnpm --filter @aura-note/persistence test && pnpm --filter @aura-note/persistence typecheck",
    "persistence:local-db-readiness": "node scripts/validate-local-database-readiness.js",
    "persistence:local-db:migrate-evidence": "node scripts/verify-local-postgres-migration.js",
    "persistence:prisma-schedule-adapter": "pnpm db:client:generate && pnpm --filter @aura-note/api test:prisma-schedule-adapter",
    "persistence:tenant-isolation": "node scripts/verify-tenant-isolation.js",
    "persistence:visit-capture-adapter": "node scripts/verify-visit-capture-adapter.js",
    "persistence:review-panel-adapter": "node scripts/verify-review-panel-adapter.js",
    "persistence:finalization-output-adapter": "node scripts/verify-finalization-output-adapter.js",
    "persistence:durable-runtime-readiness": "node scripts/verify-durable-runtime-readiness.js",
    "runtime:persistence-readiness": "node scripts/verify-runtime-persistence-readiness.js",
    "api:runtime-hardening-readiness": "pnpm --filter @aura-note/api test:runtime-hardening && node scripts/validate-api-runtime-hardening-readiness.js",
    "identity:runtime-boundary-readiness": "pnpm --filter @aura-note/api test:identity-runtime && node scripts/validate-identity-runtime-boundary-readiness.js",
    "persistence:phi-db-review-readiness": "node scripts/validate-phi-db-review-readiness.js",
    "standalone:patient-schedule-readiness": "node scripts/validate-standalone-patient-schedule-readiness.js",
    "standalone:operations-readiness": "node scripts/validate-standalone-operations-readiness.js",
    "standalone:workflow-readiness": "pnpm --filter @aura-note/web test:e2e && node scripts/validate-standalone-workflow-readiness.js",
    "audio:transcription-readiness": "node scripts/validate-audio-transcription-readiness.js",
    "transcription:runtime-boundary-readiness": "pnpm --filter @aura-note/api test:transcription-runtime && pnpm --filter @aura-note/worker test && node scripts/validate-transcription-runtime-boundary-readiness.js",
    "transcription:live-review-readiness": "node scripts/validate-transcription-live-review-readiness.js",
    "identity:production-readiness": "node scripts/validate-production-identity-readiness.js",
    "identity:live-review-readiness": "node scripts/validate-identity-live-review-readiness.js",
    "config:production-readiness": "node scripts/validate-production-config-readiness.js",
    "observability:production-readiness": "pnpm --filter @aura-note/security test && pnpm --filter @aura-note/api test && node scripts/validate-observability-production-readiness.js",
    "ehr:integration-readiness": "pnpm --filter @aura-note/ehr-adapters test && pnpm --filter @aura-note/api test && node scripts/validate-ehr-integration-readiness.js",
    "ehr:sandbox-runtime-readiness": "pnpm --filter @aura-note/ehr-adapters test && pnpm --filter @aura-note/api test:ehr-sandbox-runtime && node scripts/validate-ehr-sandbox-runtime-readiness.js",
    "ehr:live-review-readiness": "node scripts/validate-ehr-live-review-readiness.js",
    "clinicos:integration-readiness": "pnpm --filter @aura-note/clinicos-adapter test && pnpm --filter @aura-note/api test && node scripts/validate-clinicos-integration-readiness.js",
    "clinicos:live-review-readiness": "node scripts/validate-clinicos-live-review-readiness.js",
    "mode:adapter-readiness": "pnpm --filter @aura-note/api test:mode-adapter && node scripts/validate-mode-adapter-readiness.js",
    "ai:governance-readiness": "pnpm --filter @aura-note/ai-gateway test && pnpm --filter @aura-note/api test && node scripts/validate-ai-governance-readiness.js",
    "ai:runtime-governance-readiness": "pnpm --filter @aura-note/ai-gateway test && pnpm --filter @aura-note/api test:ai-runtime-governance && node scripts/validate-ai-runtime-governance-readiness.js",
    "ai:live-review-readiness": "node scripts/validate-ai-live-review-readiness.js",
    "security:review-readiness": "pnpm --filter @aura-note/security test && pnpm --filter @aura-note/api test && node scripts/validate-security-review-readiness.js",
    "frontend:runtime-integration-readiness": "pnpm --filter @aura-note/web test:e2e && node scripts/validate-frontend-runtime-integration-readiness.js",
    "frontend:primary-runtime-readiness": "pnpm --filter @aura-note/web test:e2e && node scripts/validate-frontend-primary-runtime-readiness.js",
    "figma:backend-catch-up-readiness": "pnpm --filter @aura-note/api test:e2e && node scripts/validate-figma-backend-catch-up-readiness.js",
    "figma:handoff-pack-readiness": "node scripts/validate-figma-handoff-pack.js",
    "figma:handoff-readiness": "pnpm --filter @aura-note/web test:e2e && node scripts/validate-figma-handoff-readiness.js && pnpm figma:handoff-pack-readiness",
    "performance:launch-baseline": "node scripts/simulate-launch-performance-baseline.js",
    "launch:ops-readiness": "pnpm performance:launch-baseline && pnpm --filter @aura-note/web test:e2e && node scripts/validate-launch-ops-readiness.js",
    "pilot:readiness": "node scripts/simulate-pilot-launch-smoke.js && pnpm frontend:runtime-integration-readiness && node scripts/validate-pilot-readiness.js",
    "launch:readiness": "pnpm launch:ops-readiness && pnpm pilot:readiness",
    "claim-decision:readiness": "node scripts/validate-claim-decision-readiness.js",
    "security:commercial-readiness": "pnpm --filter @aura-note/api test:commercial-readiness && node scripts/validate-security-commercial-readiness.js",
    "ops:commercial-readiness": "pnpm --filter @aura-note/api test:commercial-readiness && node scripts/validate-ops-commercial-readiness.js",
    "billing:revenue-integrity-readiness": "pnpm --filter @aura-note/api test:commercial-readiness && node scripts/validate-billing-revenue-integrity-readiness.js",
    "beta:pilot-package-readiness": "node scripts/simulate-pilot-launch-smoke.js && pnpm --filter @aura-note/web test:e2e && node scripts/validate-beta-pilot-package-readiness.js",
    "commercial:readiness": "pnpm security:commercial-readiness && pnpm ops:commercial-readiness && pnpm billing:revenue-integrity-readiness && pnpm beta:pilot-package-readiness && node scripts/validate-commercial-readiness.js",
    "post-cr4:launch-governance": "node scripts/validate-post-cr4-launch-governance.js",
    "post-cr4:next-work-orders": "node scripts/validate-post-cr4-next-work-orders.js",
    "post-p11:readiness": "node scripts/validate-post-p11-continuation-readiness.js",
    "commercial:readiness-plan": "node scripts/validate-commercial-readiness-plan.js",
    "storage:azure-adapter-readiness": "pnpm --filter @aura-note/storage test && pnpm --filter @aura-note/storage typecheck && node scripts/validate-azure-storage-adapter-readiness.js",
    "storage:secure-download-readiness": "pnpm --filter @aura-note/storage test && pnpm --filter @aura-note/api test && node scripts/validate-secure-download-readiness.js",
    "storage:live-review-readiness": "node scripts/validate-storage-live-review-readiness.js",
    "retention:storage-deletion-readiness": "pnpm --filter @aura-note/worker test && node scripts/validate-storage-retention-readiness.js",
    "retention:production-readiness": "pnpm --filter @aura-note/worker test && pnpm --filter @aura-note/storage test && node scripts/validate-retention-production-readiness.js",
    "production:readiness": "node scripts/production-build-readiness.js",
    "storybook": "pnpm --filter @aura-note/web storybook",
    "status": "node scripts/status.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^20.14.0",
    "prisma": "^6.0.0",
    "tsx": "^4.19.0",
    "turbo": "^2.1.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0"
  }
}
